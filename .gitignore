my_his.cnf
my_cloud_db.cnf
.env

# 会话密钥（首次启动自动生成，等同于凭据，禁止上传）
.his_secret_key

# 运行时产生的导出文件
web_app/exports/

# 论文与上传暂存目录
report/
论文素材/
_github_upload/

# 本机工具数据（会话记忆等，含个人信息，禁止上传）
.workbuddy/
memory/

# 内网穿透工具（cpolar 安装包等，不上传）
.cpolar/

# 微信开发者工具本地私有配置（含个人本地设置，不上传）
miniapp/project.private.config.json

# 小程序项目配置（含正式 AppID，上传体验版时本地改回，不上传公开仓库）
miniapp/project.config.json

# 课程报告（含学生姓名、学号等个人信息，不上传公开仓库）
课程报告/

# 本地数据备份（角色/账号清理前后导出的 JSON，不上传）
backups/

# 毕业论文、演示脚本（同上，含个人信息，不上传公开仓库）
毕业论文/
