/* app.wxss —— 全局样式 */
page {
  background: #f5f6f8;
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
}

.container {
  padding: 24rpx;
}

/* 通用卡片 */
.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #222;
  margin-bottom: 16rpx;
}

/* 主按钮 */
.btn-primary {
  background: #2f6fed;
  color: #fff;
  border-radius: 44rpx;
  font-size: 32rpx;
  padding: 18rpx 0;
  text-align: center;
  margin-top: 32rpx;
}

.btn-primary.disabled {
  background: #b8c6e0;
}

/* 标签 */
.tag {
  display: inline-block;
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  margin-right: 12rpx;
}

.tag-blue { background: #e8f0ff; color: #2f6fed; }
.tag-green { background: #e6f7ef; color: #18a058; }
.tag-gray { background: #f0f1f3; color: #8a8f99; }
.tag-orange { background: #fff3e6; color: #f08c00; }

/* 列表行 */
.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f1f3;
}

.row:last-child { border-bottom: none; }

.row-left { flex: 1; }
.row-title { font-size: 30rpx; font-weight: 500; color: #222; }
.row-sub { font-size: 24rpx; color: #8a8f99; margin-top: 6rpx; }
.row-right { text-align: right; }

/* 空状态 */
.empty {
  text-align: center;
  color: #b0b4bd;
  font-size: 26rpx;
  padding: 80rpx 0;
}

/* 加载态 */
.loading {
  text-align: center;
  color: #8a8f99;
  font-size: 26rpx;
  padding: 60rpx 0;
}
