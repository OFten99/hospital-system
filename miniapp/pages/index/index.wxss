/* pages/index/index.wxss —— 参考医院预约界面风格 */
.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #f5f6f8;
}

/* ---------- 顶部搜索栏 ---------- */
.topbar {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 24rpx;
  background: #2f6fed;
}

.search-box {
  flex: 1;
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 36rpx;
  padding: 12rpx 24rpx;
  gap: 12rpx;
}

.search-icon { font-size: 26rpx; }

.search-input {
  flex: 1;
  font-size: 26rpx;
}

.search-clear {
  color: #b0b4bd;
  font-size: 26rpx;
  padding: 0 8rpx;
}

.mine-link {
  color: #fff;
  font-size: 28rpx;
}

/* ---------- 挂号时间提示条 ---------- */
.reg-time-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 20rpx 24rpx 0;
  padding: 18rpx 24rpx;
  background: #fff7e6;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #ad6800;
}

.reg-time-icon {
  font-size: 26rpx;
}

.reg-time-text {
  font-weight: 500;
}

/* ---------- 医院头卡 ---------- */
.hospital-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: #fff;
  padding: 24rpx;
  margin: 20rpx 24rpx 0;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.hospital-logo {
  width: 96rpx;
  height: 96rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #2f6fed, #5b8def);
  color: #fff;
  font-size: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.hospital-info { flex: 1; min-width: 0; }

.hospital-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.hospital-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #222;
}

.hospital-level {
  font-size: 20rpx;
  color: #2f6fed;
  background: #e8f0ff;
  border-radius: 6rpx;
  padding: 2rpx 10rpx;
  flex-shrink: 0;
}

.hospital-addr {
  font-size: 24rpx;
  color: #8a8f99;
  margin-top: 8rpx;
}

.notice-link {
  font-size: 24rpx;
  color: #2f6fed;
  flex-shrink: 0;
}

/* ---------- 就医须知弹窗 ---------- */
.mask {
  position: fixed;
  left: 0; right: 0; top: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 99;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 60rpx;
}

.notice-modal {
  background: #fff;
  border-radius: 20rpx;
  width: 100%;
  padding: 36rpx 32rpx;
  display: flex;
  flex-direction: column;
  max-height: 75vh;
}

.notice-title {
  text-align: center;
  font-size: 34rpx;
  font-weight: 600;
  margin-bottom: 24rpx;
}

.notice-body {
  max-height: 46vh;
  font-size: 26rpx;
  color: #444;
  line-height: 1.8;
  white-space: pre-line;
}

.notice-btn {
  margin-top: 28rpx;
  background: #2f6fed;
  color: #fff;
  border-radius: 40rpx;
  text-align: center;
  font-size: 30rpx;
  padding: 18rpx 0;
}

/* ---------- 双栏 ---------- */
.dual {
  flex: 1;
  display: flex;
  margin-top: 20rpx;
  overflow: hidden;
  background: #fff;
}

.left-col {
  width: 200rpx;
  background: #f0f1f3;
  height: 100%;
}

.left-item {
  padding: 28rpx 16rpx;
  font-size: 26rpx;
  color: #555;
  text-align: center;
  border-left: 6rpx solid transparent;
}

.left-item.active {
  background: #fff;
  color: #2f6fed;
  font-weight: 600;
  border-left-color: #2f6fed;
}

.right-col {
  flex: 1;
  height: 100%;
  padding: 24rpx;
  box-sizing: border-box;
}

.right-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #222;
  margin-bottom: 16rpx;
}

/* ---------- 医生条目 ---------- */
.doc-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #f0f1f3;
}

.doc-item:last-child { border-bottom: none; }

.doc-avatar {
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  background: #e8f0ff;
  color: #2f6fed;
  font-size: 34rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.doc-main { flex: 1; min-width: 0; }

.doc-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.doc-name {
  font-size: 30rpx;
  font-weight: 500;
  color: #222;
}

.doc-sub {
  font-size: 24rpx;
  color: #8a8f99;
  margin-top: 6rpx;
}

.doc-fee {
  color: #f5222d;
  font-size: 28rpx;
  font-weight: 600;
  flex-shrink: 0;
}

/* ---------- 状态 ---------- */
.loading {
  text-align: center;
  color: #8a8f99;
  font-size: 26rpx;
  padding: 60rpx 0;
}

.empty {
  text-align: center;
  color: #b0b4bd;
  font-size: 26rpx;
  padding: 80rpx 0;
}

.error-box {
  background: #fff3f3;
  border: 1rpx solid #ffd6d6;
  color: #c0392b;
  border-radius: 12rpx;
  padding: 24rpx;
  margin: 24rpx;
  font-size: 26rpx;
  line-height: 1.7;
  white-space: pre-line;
}

.search-panel {
  flex: 1;
  margin: 20rpx 24rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  overflow-y: auto;
}
