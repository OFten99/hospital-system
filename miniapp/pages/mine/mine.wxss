/* pages/mine/mine.wxss —— 个人中心（参考医院小程序风格） */
.page {
  min-height: 100vh;
  background: #f5f6f8;
  padding-bottom: 40rpx;
}

/* 蓝色渐变头卡 */
.header {
  background: linear-gradient(180deg, #2f6fed 0%, #5b8df5 100%);
  padding: 48rpx 32rpx 72rpx;
}

.header-row {
  display: flex;
  align-items: center;
}

.avatar {
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  background: #dcebff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 60rpx;
  flex-shrink: 0;
}

.user-info {
  flex: 1;
  margin-left: 24rpx;
  color: #fff;
}

.user-name {
  font-size: 38rpx;
  font-weight: 700;
}

.user-sub {
  font-size: 24rpx;
  opacity: .85;
  margin-top: 6rpx;
}

.setting {
  color: #fff;
  font-size: 26rpx;
  opacity: .92;
}

/* 菜单卡片：上提盖住头卡底部 */
.menu {
  margin: -40rpx 24rpx 0;
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(47, 111, 237, .06);
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 30rpx 28rpx;
  border-bottom: 1rpx solid #f0f2f5;
}

.menu-item:last-child {
  border-bottom: none;
}

.mi-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  flex-shrink: 0;
}

.mi-title {
  flex: 1;
  margin-left: 22rpx;
  font-size: 30rpx;
  color: #2b2f36;
}

.mi-sub {
  font-size: 24rpx;
  color: #b0b4bd;
  margin-right: 12rpx;
}

.mi-arrow {
  color: #c3c7cf;
  font-size: 34rpx;
}
